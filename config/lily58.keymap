#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4   &kp N5                         &kp N6  &kp N7           &kp N8        &kp N9   &kp N0         &kp ENTER
&kp TAB    &kp Q   &kp W   &kp F     &kp P    &kp B                          &kp J   &kp L            &kp U         &kp Y    &kp SEMICOLON  &kp INSERT
&kp LSHFT  &kp A   &kp R   &kp S     &kp T    &kp G                          &kp M   &kp N            &kp E         &kp I    &kp O          &kp BACKSPACE
&kp LCTRL  &kp Z   &kp X   &kp C     &kp D    &kp V   &kp LBKT     &kp RBKT  &kp N   &kp M            &kp COMMA     &kp DOT  &kp FSLH       &kp DELETE
                           &kp LALT  &kp ESC  &mo 2   &kp SPACE    &kp RET   &mo 1   &kp RIGHT_SHIFT  &kp LEFT_WIN
            >;
        };

        lower_layer {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2          &bt BT_SEL 3    &bt BT_SEL 4                     &trans            &trans           &trans                 &trans           &trans        &trans
&kp F1      &kp F2            &kp F3             &kp F4                &kp F5          &kp F6                           &kp F7            &kp F8           &kp F9                 &kp F10          &kp F11       &kp F12
&kp GRAVE   &kp MINUS         &kp AT             &kp LEFT_PARENTHESIS  &kp LEFT_BRACE  &kp LESS_THAN                    &kp GREATER_THAN  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp EXCLAMATION  &kp UP_ARROW  &kp KP_DIVIDE
&trans      &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG     &kp UNDER       &kp EXCL       &trans    &trans  &kp N1            &kp N2           &kp N3                 &kp LEFT         &kp DOWN      &kp RIGHT
                                                 &trans                &trans          &trans         &trans    &trans  &trans            &trans           &trans
            >;
        };

        raise_layer {
            bindings = <
&trans            &trans          &trans      &trans      &trans             &trans                                  &trans       &trans        &trans        &trans     &trans        &trans
&kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOL_UP                            &kp N6       &kp N7        &kp N8        &kp N9     &kp N0        &trans
&kp F1            &kp F2          &kp F3      &kp F4      &kp ASTRK          &kp LEFT_PARENTHESIS                    &kp LEFT     &kp UP_ARROW  &kp DOWN      &kp RIGHT  &kp UP_ARROW  &kp KP_DIVIDE
&kp F7            &kp F8          &kp F9      &kp F10     &kp UNDER          &kp EXCL              &trans    &trans  &kp KP_PLUS  &kp MINUS     &kp EQUAL     &kp LEFT   &kp DOWN      &kp RIGHT
                                              &trans      &trans             &trans                &trans    &trans  &trans       &trans        &kp LEFT_WIN
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        a3rdLayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
