#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4   &kp N5                                 &kp N6  &kp N7           &kp N8        &kp N9   &kp N0         &kp ENTER
&kp TAB    &kp Q   &kp W   &kp F     &kp P    &kp B                                  &kp J   &kp L            &kp U         &kp Y    &kp SEMICOLON  &kp INSERT
&kp LSHFT  &kp A   &kp R   &kp S     &kp T    &kp G                                  &kp M   &kp N            &kp E         &kp I    &kp O          &kp DELETE
&kp LCTRL  &kp Z   &kp X   &kp C     &kp D    &kp V   &kp RA(GRAVE)    &kp RA(PLUS)  &kp N   &kp M            &kp COMMA     &kp DOT  &kp FSLH       &kp BACKSPACE
                           &kp LALT  &kp ESC  &mo 2   &kp SPACE        &kp RET       &mo 1   &kp RIGHT_SHIFT  &kp LEFT_WIN
            >;
        };

        lower_layer {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3          &bt BT_SEL 4                     &trans        &trans                 &trans      &trans           &trans        &trans
&kp F1      &kp F2            &kp F3             &kp F4             &kp F5                &kp F6                           &kp F7        &kp F8                 &kp F9      &kp F10          &kp F11       &kp F12
&kp GRAVE   &kp QUESTION      &kp RA(NUMBER_2)   &kp LS(N8)         &kp RA(LEFT_BRACKET)  &kp NUBS                         &kp LS(NUBS)  &kp RA(RIGHT_BRACKET)  &kp LS(N9)  &kp EXCLAMATION  &kp UP_ARROW  &kp KP_DIVIDE
&trans      &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &kp UNDER             &kp LS(SLASH)  &trans    &trans  &kp N1        &kp N2                 &kp N3      &kp LEFT         &kp DOWN      &kp RIGHT
                                                 &trans             &trans                &trans         &trans    &trans  &trans        &trans                 &trans
            >;
        };

        raise_layer {
            bindings = <
&trans  &kp RA(N1)     &kp RA(N2)     &kp RA(N3)     &kp RA(N4)     &kp RA(N5)                              &kp RA(N6)     &kp RA(N7)     &kp RA(N8)     &kp RA(N9)     &kp RA(N0)     &trans
&trans  &kp RA(LBKT)   &kp RA(RBKT)   &kp RA(SCLN)   &kp RA(BSLH)   &kp RA(MINUS)                           &kp LBKT       &kp RBKT       &kp LBRC       &kp RBRC       &kp RA(Q)      &trans
&trans  &kp MINUS      &kp SLASH      &kp EQUAL      &kp INT_RO     &kp UNDER                               &kp LS(N7)     &kp LS(N8)     &kp LS(N9)     &kp LS(N0)     &kp RA(E)      &trans
&trans  &kp LS(LBKT)   &kp LS(RBKT)   &kp LS(SCLN)   &kp LS(BSLH)   &kp LS(MINUS)  &trans    &trans         &kp RA(GRAVE)  &kp RA(PLUS)   &kp RA(COMMA)  &kp RA(DOT)    &kp RA(A)      &trans
                                      &trans         &trans         &trans         &trans    &trans         &trans         &trans         &trans
            >;
        };
    };
};
